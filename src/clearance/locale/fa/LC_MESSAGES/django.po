msgid "Superuser"
msgstr "ابرکاربر"

msgid "Nobody found."
msgstr "کسی پیدا نشد."

msgid "Previous"
msgstr "قبلی"

msgid "Every permission"
msgstr "همه‌ی مجوزها"

msgid "Only those nobody holds"
msgstr "فقط آن‌هایی که هیچ کس ندارد"

