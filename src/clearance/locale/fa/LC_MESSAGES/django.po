msgstr "در بسته‌ها"

msgid "Given to people"
msgstr "داده‌شده به افراد"

msgid "Taken away"
msgstr "گرفته‌شده"

msgid "names"
msgstr "اسم‌ها"

msgid ""
"A superuser holds every permission and reaches every row, whatever is given "
"here."
msgstr ""
"ابرکاربر، هر چه این‌جا داده شود، همه‌ی مجوزها را دارد و به همه‌ی ردیف‌ها می‌رسد."

msgid "Roles"
msgstr "نقش‌ها"

msgid "Take back"
msgstr "پس گرفتن"

msgid "No bundles."
msgstr "بسته‌ای ندارد."

msgid "from their role"
msgstr "از نقششان"

msgid "Give"
msgstr "دادن"

msgid "Their own grants"
msgstr "مجوزهایی که به خودشان داده شده"

msgid "the model's default"
msgstr "پیش‌فرض مدل"

msgid "Give back"
msgstr "پس دادن"

msgid "Give or take away one permission"
msgstr "دادن یا گرفتن یک مجوز"

msgid "why it is taken away"
msgstr "چرا گرفته می‌شود"

msgid "Reason"
msgstr "دلیل"

msgid "Take away"
msgstr "گرفتن"

msgid "What they end up allowed"
msgstr "آنچه در نهایت اجازه دارند"

msgid "From"
msgstr "از"

msgid "their own grant"
msgstr "مجوزی که به خودشان داده شده"

msgid "Given, but stopped by their roles' ceiling"
msgstr "داده شده، ولی سقف نقش‌هایشان جلویش را گرفته"

#, python-format
msgid "used by %(grants)s grant"
msgid_plural "used by %(grants)s grants"
msgstr[0] "در %(grants)s اعطا به کار رفته"
msgstr[1] "در %(grants)s اعطا به کار رفته"

msgid "Rows that meet"
msgstr "ردیف‌هایی مطابق با"

msgid "Operator"
msgstr "عملگر"

msgid "Compared with"
msgstr "مقایسه با"

msgid "a value"
msgstr "یک مقدار"

msgid "the person's"
msgstr "مال شخص"

msgid "Remove"
msgstr "برداشتن"

