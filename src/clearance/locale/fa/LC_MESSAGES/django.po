msgstr "فقط این اکشن آن را می‌نویسد"

msgid "It may write from it"
msgstr "می‌تواند از آن بنویسد"

msgid "Writing from no value ticked is writing from any."
msgstr "اگر هیچ مقداری تیک نخورده باشد، از هر مقداری می‌نویسد."

msgid "Other actions on this field"
msgstr "اکشن‌های دیگر روی این فیلد"

msgid "Save"
msgstr "ذخیره"

msgid "Delete"
msgstr "حذف"

#, python-format
msgid ""
"Deleting %(name)s takes its permission from everybody holding it, and lets "
