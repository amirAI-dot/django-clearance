#, python-format
msgid "Deleting %(name)s takes what it gives from the one person holding it."
msgid_plural ""
"Deleting %(name)s takes what it gives from the %(people)s people holding it."
msgstr[0] "حذف %(name)s آنچه را می‌دهد از تنها کسی که آن را دارد می‌گیرد."
msgstr[1] ""
"حذف %(name)s آنچه را می‌دهد از %(people)s نفری که آن را دارند می‌گیرد."

msgid "Bundle"
msgstr "بسته"

