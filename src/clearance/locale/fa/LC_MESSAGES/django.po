msgstr "اکشن وضعیت"

msgid "status actions"
msgstr "اکشن‌های وضعیت"

msgid "writes"
msgstr "می‌نویسد"

msgid "writes from"
msgstr "می‌نویسد از"

msgid "end"
msgstr "سمت"

msgid "status action value"
msgstr "مقدار اکشن وضعیت"

msgid "status action values"
msgstr "مقدارهای اکشن وضعیت"

msgid "bundle"
msgstr "بسته"

msgid "role"
msgstr "نقش"

