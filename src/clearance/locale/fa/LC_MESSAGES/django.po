#, python-format
msgid "%(code)r is not an action: use lowercase words joined by underscores."
msgstr ""
"%(code)r اکشن نیست: از کلمه‌های با حروف کوچک استفاده کنید که با زیرخط به هم "
"وصل شده‌اند."

#, python-format
msgid "%(code)r is an action every model has already."
msgstr "%(code)r اکشنی است که هر مدلی از قبل دارد."

#, python-format
msgid "%(model)s has no field %(field)r."
msgstr "%(model)s فیلدی به اسم %(field)r ندارد."

#, python-format
msgid "%(field)s has no choices, and is not yes or no."
msgstr "%(field)s گزینه ندارد، و بله یا نه هم نیست."

msgid "It writes no value."
msgstr "هیچ مقداری نمی‌نویسد."

#, python-format
msgid "%(value)r is not one of the values of %(field)s."
msgstr "%(value)r یکی از مقدارهای %(field)s نیست."

msgid "Actions"
msgstr "اکشن‌ها"

msgid "The status action was saved."
msgstr "اکشن وضعیت ذخیره شد."

msgid "Add a status action"
msgstr "افزودن اکشن وضعیت"

msgid "The status action was deleted."
msgstr "اکشن وضعیت حذف شد."

#, python-format
msgid "Delete %(name)s"
msgstr "حذف %(name)s"

msgid "Protected fields"
msgstr "فیلدهای محافظت‌شده"

#, python-format
msgid "%(field)s is protected."
msgstr "%(field)s محافظت شد."

#, python-format
msgid "%(field)s is no longer protected."
msgstr "%(field)s دیگر محافظت‌شده نیست."

msgid "Row scopes"
msgstr "دامنه‌های ردیف"

msgid "The rule scope was saved."
msgstr "دامنه‌ی قانونی ذخیره شد."

msgid "Add a rule scope"
msgstr "افزودن دامنه‌ی قانونی"

msgid "The rule scope was deleted."
msgstr "دامنه‌ی قانونی حذف شد."

msgid "Access"
msgstr "دسترسی"

msgid "Bundles"
msgstr "بسته‌ها"

msgid "People"
msgstr "افراد"

msgid "Permissions"
msgstr "مجوزها"

#, python-format
msgid "The bundle %(name)s was saved."
msgstr "بسته‌ی %(name)s ذخیره شد."

msgid "Add a bundle"
msgstr "افزودن بسته"

#, python-format
msgid "The bundle %(name)s was deleted."
msgstr "بسته‌ی %(name)s حذف شد."

msgid "The bundle was given."
msgstr "بسته داده شد."

msgid "The bundle was taken back."
msgstr "بسته پس گرفته شد."

msgid "The permission was given."
msgstr "مجوز داده شد."

msgid "The permission was taken away."
msgstr "مجوز گرفته شد."

msgid "The permission was given back."
msgstr "مجوز پس داده شد."

msgid "Nothing was asked for."
msgstr "چیزی خواسته نشد."

msgid "A bundle needs a name."
msgstr "هر بسته یک اسم لازم دارد."

#, python-format
msgid "There is a bundle called %(name)s already."
msgstr "بسته‌ای به اسم %(name)s از قبل هست."

#, python-format
msgid "%(field)s is a relation of another model, not a field of its own."
msgstr "%(field)s رابطه‌ی یک مدل دیگر است، نه فیلدی از خود این مدل."

#, python-format
msgid "%(field)s is the primary key, how a row is found."
msgstr "%(field)s کلید اصلی است، که ردیف با آن پیدا می‌شود."

#, python-format
msgid "%(field)s is the password, which is never shown at all."
msgstr "%(field)s رمز عبور است، که هرگز نشان داده نمی‌شود."

#, python-format
msgid "You may not set %(field)s to %(value)s."
msgstr "شما نمی‌توانید %(field)s را %(value)s کنید."

